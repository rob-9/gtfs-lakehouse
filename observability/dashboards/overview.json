{
  "title": "GTFS lakehouse",
  "uid": "gtfs-lakehouse",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {"id": 1, "title": "Running Flink jobs", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_flink_running_jobs", "refId": "A"}]},
    {"id": 2, "title": "Final route windows", "type": "stat", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_serving_windows", "refId": "A"}]},
    {"id": 3, "title": "Checkpoint duration (ms)", "type": "timeseries", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_flink_checkpoint_duration_ms", "refId": "A"}]},
    {"id": 4, "title": "Failed checkpoints", "type": "timeseries", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_flink_failed_checkpoints", "refId": "A"}]},
    {"id": 5, "title": "Exporter healthy", "type": "stat", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_exporter_up", "refId": "A"}]},
    {"id": 6, "title": "Poller reachable", "type": "stat", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "up{job=\"gtfs-poller\"}", "refId": "A"}]},
    {"id": 7, "title": "HTTP attempts / second", "type": "timeseries", "gridPos": {"x": 0, "y": 13, "w": 8, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(gtfs_poll_attempts_total[5m])", "legendFormat": "{{agency}} / {{feed}}", "refId": "A"}]},
    {"id": 8, "title": "HTTP successes / second", "type": "timeseries", "gridPos": {"x": 8, "y": 13, "w": 8, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(gtfs_poll_responses_total[5m])", "legendFormat": "{{agency}} / {{feed}} / {{status}}", "refId": "A"}]},
    {"id": 9, "title": "Poller errors / second", "type": "timeseries", "gridPos": {"x": 16, "y": 13, "w": 8, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(gtfs_poller_errors_total[5m])", "legendFormat": "{{agency}} / {{feed}} / {{stage}}", "refId": "A"}]},
    {"id": 10, "title": "Time since HTTP success", "type": "timeseries", "gridPos": {"x": 0, "y": 21, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "time() - gtfs_poll_last_success_timestamp_seconds", "legendFormat": "{{agency}} / {{feed}}", "refId": "A"}]},
    {"id": 11, "title": "Source age (last published snapshot)", "description": "Newest normalized observation in the last acknowledged snapshot. 304 does not refresh this timestamp. Unknown after restart until a snapshot is published; synthetic fixtures are deliberately old.", "type": "timeseries", "gridPos": {"x": 8, "y": 21, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "time() - gtfs_feed_observed_timestamp_seconds", "legendFormat": "{{agency}} / {{feed}}", "refId": "A"}]},
    {"id": 12, "title": "Pending snapshot age", "type": "timeseries", "gridPos": {"x": 16, "y": 21, "w": 8, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "(time() - gtfs_outbox_pending_since_timestamp_seconds) and (gtfs_outbox_pending_snapshots > 0)", "legendFormat": "{{agency}} / {{feed}}", "refId": "A"}]},
    {"id": 13, "title": "Pending snapshots", "type": "timeseries", "gridPos": {"x": 0, "y": 29, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_outbox_pending_snapshots", "legendFormat": "{{agency}} / {{feed}}", "refId": "A"}]},
    {"id": 14, "title": "Acknowledged publications / second", "type": "timeseries", "gridPos": {"x": 12, "y": 29, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "rate(gtfs_poller_published_snapshots_total[5m])", "legendFormat": "{{agency}} / {{feed}}", "refId": "A"}]},
    {"id": 15, "title": "Kafka group collection healthy", "type": "timeseries", "gridPos": {"x": 0, "y": 37, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "gtfs_kafka_group_collection_up", "legendFormat": "{{group}} / {{topic}}", "refId": "A"}]},
    {"id": 16, "title": "Kafka committed-offset lag", "type": "timeseries", "gridPos": {"x": 12, "y": 37, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (group, topic) (gtfs_kafka_consumer_lag)", "legendFormat": "{{group}} / {{topic}}", "refId": "A"}]},
    {"id": 17, "title": "Kafka partitions without commits", "type": "timeseries", "gridPos": {"x": 0, "y": 45, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (group, topic) (1 - gtfs_kafka_committed_offset_known)", "legendFormat": "{{group}} / {{topic}}", "refId": "A"}]},
    {"id": 18, "title": "Kafka offsets outside retained range", "type": "timeseries", "gridPos": {"x": 12, "y": 45, "w": 12, "h": 8}, "datasource": {"uid": "prometheus"}, "targets": [{"expr": "sum by (group, topic) (gtfs_kafka_committed_offset_out_of_range)", "legendFormat": "{{group}} / {{topic}}", "refId": "A"}]}
  ]
}
